# Configure secrets in the server environment or in an ignored local .env.
URL_API_GRM=https://replace-with-authorized-grm-api
TOKEN_API_APONTAMENTOS_GRM_PUSH=replace-me

# Telegram credentials are required only when running the legacy bot.
TOKEN_BOT_GRM=
CHAT_IDS_ALERTA=
RECIPIENT_IDS_STATUS=

# Supabase Auth OAuth Server (configure asymmetric JWT signing in Supabase).
OIDC_ISSUER=https://byjmnvnojwssjswyeybj.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_CLIENT_ID=replace-with-public-mobile-client-id
OIDC_ALLOWED_EMAILS=authorized.user@example.com
SUPABASE_URL=https://byjmnvnojwssjswyeybj.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# PostgreSQL server connection (use the Supabase Connect URI; SSL is required).
SUPABASE_DB_URL=postgresql://postgres:replace-me@db.byjmnvnojwssjswyeybj.supabase.co:5432/postgres
