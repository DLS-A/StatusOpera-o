# Modelo administrativo: valores privados vazios; preencher somente no ambiente.
URL_API_GRM=https://dr-db.grm.valeglobal.net/api/v2/status-log-base-report
TOKEN_API_APONTAMENTOS_GRM_PUSH=

# Telegram credentials are required only when running the legacy bot.
TOKEN_BOT_GRM=
CHAT_IDS_ALERTA=
RECIPIENT_IDS_STATUS=

# Supabase Auth OAuth Server (configure asymmetric JWT signing in Supabase).
OIDC_ISSUER=https://byjmnvnojwssjswyeybj.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_CLIENT_ID=
OIDC_ALLOWED_EMAILS=
SUPABASE_URL=https://byjmnvnojwssjswyeybj.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL server connection (use the Supabase Connect URI; SSL is required).
SUPABASE_DB_URL=
# CA obtida no Dashboard Supabase; hostname precisa corresponder ao certificado.
PGSSLROOTCERT=/etc/secrets/supabase-ca.crt
SNAPSHOT_INTERVAL_SECONDS=60
SNAPSHOT_STALE_SECONDS=120
SNAPSHOT_RETENTION_DAYS=7
# Categorias KPI confirmadas pelo responsável; vazias = classificação desconhecida.
OPERATING_KPI_CATEGORIES=
STOPPED_KPI_CATEGORIES=
# Em Render com ingresso exclusivo por proxy: *. Não usar * em porta exposta direta.
FORWARDED_ALLOW_IPS=127.0.0.1
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=
# Alternativa ao JSON de ambiente: arquivo de segredo, nunca empacotado no APK.
GOOGLE_APPLICATION_CREDENTIALS=
